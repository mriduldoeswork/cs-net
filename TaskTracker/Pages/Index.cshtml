@page
@model TaskTracker.Pages.IndexModel

@{
    ViewData["Title"] = "Task Tracker";
}

<div class="text-center">
    <h1 class="display-4">Task Tracker</h1>
    <p>Manage your learning tasks.</p>
</div>

<form method="post" asp-page-handler="Add" class="mb-4">
    <div class="input-group">
        <input asp-for="NewTaskTitle"
               class="form-control"
               placeholder="Enter a new task" />

        <button type="submit" class="btn btn-primary">
            Add Task
        </button>
    </div>
</form>

@if (Model.Tasks.Count == 0)
{
    <p>No tasks yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var task in Model.Tasks)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span class="@(task.IsCompleted ? "text-decoration-line-through" : "")">
                    @task.Title
                </span>

                <span>
                    <form method="post"
                          asp-page-handler="Toggle"
                          class="d-inline">
                        <input type="hidden" name="id" value="@task.Id" />
                        <button type="submit" class="btn btn-sm btn-success">
                            @(task.IsCompleted ? "Undo" : "Complete")
                        </button>
                    </form>

                    <form method="post"
                          asp-page-handler="Delete"
                          class="d-inline">
                        <input type="hidden" name="id" value="@task.Id" />
                        <button type="submit" class="btn btn-sm btn-danger">
                            Delete
                        </button>
                    </form>
                </span>
            </li>
        }
    </ul>
}
